# Sunucu (asla istemciye sızdırmayın — Vercel Environment Variables'a ekleyin)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI rate limit (TPM/RPM) — exam prep vision yoğun akışta artırın veya azaltın
# OPENAI_MAX_CONCURRENT=3
# OPENAI_MIN_INTERVAL_MS=300
# OPENAI_MAX_RETRIES=6
# EXAM_PREP_PERSIST_CONCURRENCY=1
# EXAM_PREP_VISION_PAGE_CONCURRENCY=2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Build sırasında otomatik üretilir (inject-env.mjs) — elle doldurmayın
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
