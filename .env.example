# Sunucu (asla istemciye sızdırmayın — Vercel Environment Variables'a ekleyin)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# OPENAI_MAX_CONCURRENT=3
# OPENAI_MIN_INTERVAL_MS=300
# OPENAI_MAX_RETRIES=6
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NotAl · Google Calendar (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/notal/google/callback
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build sırasında otomatik üretilir (inject-env.mjs) — elle doldurmayın
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
